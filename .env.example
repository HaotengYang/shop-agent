# Copy to .env. Everything optional: without LLM_API_KEY the agent runs on a mock model.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Dev default is SQLite at data/shop.db. Prod:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/shop
# MONGODB_URI=mongodb+srv://...

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Fixed "today" so relative-date questions stay checkable in eval
AS_OF=2026-09-01
MAX_SQL_RETRIES=2
